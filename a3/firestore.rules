rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function librarian() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'librarian';
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role'])
        && request.resource.data.role == 'member'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string;
      allow update, delete: if false;
    }
    match /books/{bookId} {
      allow read: if signedIn();
      allow create, update: if librarian()
        && request.resource.data.keys().hasOnly(['isbn', 'name'])
        && request.resource.data.isbn is int && request.resource.data.isbn > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120;
      allow delete: if librarian();
    }
    // A3 - UrbanCanopy member profiles (BR D.1)
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 1 && request.resource.data.displayName.size() <= 70;
      allow update, delete: if false;
    }
  }
}
